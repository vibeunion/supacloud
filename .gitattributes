# SupaCloud .gitattributes
# Force LF line endings for shell scripts and TypeScript files
# Prevent Windows development environments from committing CRLF, avoiding /bin/bash^M errors on Linux

# Shell scripts
 *.sh            text eol=lf
supacloud       text eol=lf
*.bash          text eol=lf

# Node/TypeScript
*.ts            text eol=lf
*.js            text eol=lf
*.json          text eol=lf

# YAML / Config
*.yml           text eol=lf
*.yaml          text eol=lf
*.env           text eol=lf
*.env.*         text eol=lf
config.env      text eol=lf

 # Markdown
 *.md            text eol=lf

# Binary files - do not convert
 *.png           binary
*.jpg           binary
*.gif           binary
*.woff          binary
*.woff2         binary
