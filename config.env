#!/bin/bash
# ============================================================
# Pigsty Supabase Deployment Configuration File
# Please modify the following configurations according to your actual environment
# ============================================================

# ========== Network Configuration ==========
# Server Internal IP Address
# Leave empty or keep default value, will be auto-detected or prompt for selection during script execution
INTERNAL_IP=""

# SupaCloud global API gateway domain (API, Auth, Realtime, Edge Functions)
# Production should set this explicitly. If left empty, the installer prompts
# or uses api.<INTERNAL_IP>.nip.io in non-interactive mode.
SUPABASE_PUBLIC_DOMAIN=""

# SupaCloud global console domain
# May be left empty; the installer derives studio.<base-domain> from
# SUPABASE_PUBLIC_DOMAIN. Production still needs DNS/HTTPS for the derived host.
# Recommended: studio.example.com when SUPABASE_PUBLIC_DOMAIN=api.example.com
SUPABASE_STUDIO_DOMAIN=""

# ========== Password Configuration ==========
# Supabase Studio Login Password
DASHBOARD_USERNAME="supabase"
DASHBOARD_PASSWORD="supacloud"

# PostgreSQL Database Password
POSTGRES_PASSWORD="DBUser.Supa"

# Grafana Admin Password
GRAFANA_PASSWORD="supacloud"

# ========== JWT Configuration ==========
# Auto-generated by default, no modification needed
# To customize, uncomment and fill in your values
# JWT_SECRET must be at least 32 characters, ANON_KEY and SERVICE_ROLE_KEY need to be generated using JWT_SECRET
# Reference: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys

# Uncomment to use custom values (leave empty for auto-generation)
#JWT_SECRET=""
#ANON_KEY=""
#SERVICE_ROLE_KEY=""

# ========== Optional Configuration ==========
# Swap size (GB), set to 0 to disable auto-creation
SWAP_SIZE_GB=4

# PostgreSQL Version (15, 16, 17, 18)
PG_VERSION=18

# Timezone
TIMEZONE="Asia/Shanghai"

# Pigsty Version
# Pin production installs for reproducibility. Override only after validating a newer release.
PIGSTY_VERSION="v4.5.0"

# Pigsty config template.
# Use Pigsty's official Supabase template for PostgreSQL extensions and base
# database roles. SupaCloud skips Pigsty app.yml by default and provides its
# own Caddy gateway and runtime services.
PIGSTY_CONFIG_TEMPLATE="supabase"

# Supabase opaque API keys. Leave empty to generate stable values during install.
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPACLOUD_INSTALL_LEGACY_SUPABASE_STACK="false"

# Gateway security limits are enabled by default and isolated by project,
# request category, and direct Caddy client socket IP.
SUPACLOUD_RATE_LIMIT_PASSWORD_PER_MINUTE="10"
SUPACLOUD_RATE_LIMIT_SIGNUP_PER_MINUTE="5"
SUPACLOUD_RATE_LIMIT_REFRESH_PER_MINUTE="120"
SUPACLOUD_RATE_LIMIT_API_PER_MINUTE="100"

# Storage Configuration
# Options: minio, juicefs (default), external
# - juicefs: uses PostgreSQL LO as storage backend, extremely low resource usage [Recommended]
S3_STORAGE_TYPE="juicefs"
JUICEFS_BACKEND="postgres"

# Image transformation engine. Pinned for reproducible installs.
IMAGINARY_IMAGE="h2non/imaginary:1.2.4"

# Private cache data plane port for systemd deployments. Port 9010 belongs to
# Imaginary on the host; Docker deployments keep their isolated container port.
PGREDIS_RUNTIME_PORT=9011

# Optional pgBackRest overrides. JuiceFS fresh installs create a dedicated
# config under /etc/supabase automatically. Existing Pigsty installations
# should point these values at their verified stanza/config instead of copying
# or replacing the Pigsty-managed file.
#SUPACLOUD_PGBACKREST_CONFIG="/etc/supabase/pgbackrest.conf"
#SUPACLOUD_PGBACKREST_STANZA="db-main"
#SUPACLOUD_PGBACKREST_USER="postgres"
#SUPACLOUD_PGBACKREST_BIN="pgbackrest"
#SUPACLOUD_PITR_ENABLED="false"

# If external is selected, configure the following parameters

# ========== Observability ==========
# SupaCloud never installs the legacy Supabase Analytics (Logflare) stack.
# Logs are collected independently from PostgreSQL and Grafana.
SUPACLOUD_LOGS_ENABLED="true"
VICTORIALOGS_VERSION="v1.52.0"
VICTORIALOGS_DATA_DIR="/var/lib/supacloud/victorialogs"
VICTORIALOGS_RETENTION="7d"

# ========== Supabase Pipelines (Public Alpha) ==========
# Builds the pinned upstream Supabase ETL replicator image used by project CDC pipelines.
SUPACLOUD_PIPELINES_ENABLED="true"
SUPACLOUD_ETL_COMMIT="cd49f6f8355c75c30c0d191542677bf6bc155607"

# ========== Temporary Database Access Gateway ==========
# CIDR-restricted JIT credentials are exposed through dedicated TCP ports.
# Set a public DNS name or IP reachable by database clients. The installer uses
# INTERNAL_IP when this is left empty and writes the fixed port range to runtime config.
JIT_DATABASE_GATEWAY_PUBLIC_HOST=""
JIT_DATABASE_GATEWAY_PORT_RANGE="6600-6699"

# Optional deployment-specific executable implementing the documented
# preflight/execute/rollback contract. Without it, major-upgrade preflight is
# reported as blocked and no destructive database command is run.
SUPACLOUD_POSTGRES_MAJOR_UPGRADE_PROVIDER_EXECUTOR=""

# ========== Edge Functions Runtime ==========
# Edge Runtime: Bun + Elysia Worker Pool (built-in, no configuration needed)
# Managed by supacloud-edge-runtime.service on port 9005 by default
#
# Optional outbound HTTPS trust controls for Edge Function fetch().
# Prefer a CA bundle for self-signed/internal certificates:
#SUPACLOUD_EDGE_TLS_CA_FILE="/etc/supacloud/edge-runtime/ca.pem"
# Or inject an inline PEM through project/function secrets:
#SUPACLOUD_EDGE_TLS_CA="-----BEGIN CERTIFICATE-----..."
#
# Last-resort compatibility switch. This disables certificate verification for
# HTTPS fetch() calls inside Edge Function workers only; do not enable globally
# unless you accept the security tradeoff.
#SUPACLOUD_EDGE_TLS_INSECURE_SKIP_VERIFY=false

# ========== SMTP Configuration (Optional) ==========
# Uncomment to enable email functionality
#SMTP_HOST="smtp.example.com"
#SMTP_PORT=587
#SMTP_USER="your-smtp-user"
#SMTP_PASS="your-smtp-password"
#SMTP_SENDER_NAME="Supabase"
#SMTP_ADMIN_EMAIL="admin@example.com"
