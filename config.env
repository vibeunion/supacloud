#!/bin/bash
# ============================================================
# Pigsty Supabase Deployment Configuration File
# Please modify the following configurations according to your actual environment
# ============================================================

# ========== Network Configuration ==========
# Server Internal IP Address
# Leave empty or keep default value, will be auto-detected or prompt for selection during script execution
INTERNAL_IP=""

# Supabase API/Public Access Domain (API, Auth, Realtime, Edge Functions)
# Leave empty or keep default value, will prompt for input during script execution
SUPABASE_PUBLIC_DOMAIN=""

# Supabase Studio Dashboard Domain
# Leave empty to default to public domain's subdomain or same domain (for single domain deployment)
# Recommended: studio.seagoo.top
SUPABASE_STUDIO_DOMAIN=""

# ========== Password Configuration ==========
# Supabase Studio Login Password
DASHBOARD_USERNAME="supabase"
DASHBOARD_PASSWORD="supacloud"

# PostgreSQL Database Password
POSTGRES_PASSWORD="DBUser.Supa"

# Grafana Admin Password
GRAFANA_PASSWORD="supacloud"

# ========== JWT Configuration ==========
# Auto-generated by default, no modification needed
# To customize, uncomment and fill in your values
# JWT_SECRET must be at least 32 characters, ANON_KEY and SERVICE_ROLE_KEY need to be generated using JWT_SECRET
# Reference: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys

# Uncomment to use custom values (leave empty for auto-generation)
#JWT_SECRET=""
#ANON_KEY=""
#SERVICE_ROLE_KEY=""

# ========== Optional Configuration ==========
# Swap size (GB), set to 0 to disable auto-creation
SWAP_SIZE_GB=4

# PostgreSQL Version (15, 16, 17, 18)
PG_VERSION=18

# Timezone
TIMEZONE="Asia/Shanghai"

# Pigsty Version
# latest: install the latest version
# You can also specify a version number, e.g.: v4.3.0
PIGSTY_VERSION="latest"

# Pigsty config template.
# Keep app/supa by default because SupaCloud replaces gateway/runtime/storage
# orchestration with its own components. Set to supabase only for explicit
# upstream Pigsty Supabase template testing.
PIGSTY_CONFIG_TEMPLATE="app/supa"

# Storage Configuration
# Options: minio, juicefs (default), external
# - juicefs: uses PostgreSQL LO as storage backend, extremely low resource usage [Recommended]
S3_STORAGE_TYPE="juicefs"
JUICEFS_BACKEND="postgres"

# If external is selected, configure the following parameters

# ========== Analytics (Logflare) ==========
# Enable Analytics (Logflare)
# true: enable (default)
# false: disable (save resources)
ENABLE_ANALYTICS=true

# Analytics Backend Type
# postgres: lightweight, logs stored in Postgres (recommended for small-scale use)
# bigquery: production-grade, logs stored in Google BigQuery
ANALYTICS_BACKEND="postgres"

# Logflare (BEAM VM) Memory Optimization Parameters
# Used to limit Erlang VM memory usage, suitable for resource-constrained environments (e.g., CI)
# Default: moderate optimization (~400-600MB memory)
# For more aggressive optimization, change to: +P 16384 +Q 2048 +S 1:1 +hms 32 +L
LOGFLARE_ERL_FLAGS="+P 32768 +Q 4096 +S 2:2 +hms 64 +hmbs 64 +e 128 +L"

# ========== Edge Functions Runtime ==========
# Edge Runtime: Bun + Elysia Worker Pool (built-in, no configuration needed)
# Managed by supacloud-edge-runtime.service on port 9000

# ========== SMTP Configuration (Optional) ==========
# Uncomment to enable email functionality
#SMTP_HOST="smtp.example.com"
#SMTP_PORT=587
#SMTP_USER="your-smtp-user"
#SMTP_PASS="your-smtp-password"
#SMTP_SENDER_NAME="Supabase"
#SMTP_ADMIN_EMAIL="admin@example.com"
