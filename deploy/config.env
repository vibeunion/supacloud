#!/bin/bash
# ============================================================
# Pigsty Supabase 部署配置文件
# 请根据您的实际环境修改以下配置
# ============================================================

# ========== 网络配置 ==========
# 服务器内网 IP 地址
# 留空或保留默认值，运行脚本时将自动检测或提示选择
INTERNAL_IP=""

# Supabase API/对外访问域名 (API, Auth, Realtime, Edge Functions)
# 留空或保留默认值，运行脚本时将提示输入
SUPABASE_PUBLIC_DOMAIN=""

# Supabase Studio 管理面板域名 (Dashboard)
# 留空则默认使用 public domain 的子域名或相同域名（如果是单域名部署）
# 建议: studio.seagoo.top
SUPABASE_STUDIO_DOMAIN=""

# ========== 密码配置 ==========
# Supabase Studio 登录密码
DASHBOARD_USERNAME="supabase"
DASHBOARD_PASSWORD="supacloud"

# PostgreSQL 数据库密码
POSTGRES_PASSWORD="DBUser.Supa"

# Grafana 管理员密码
GRAFANA_PASSWORD="supacloud"

# ========== JWT 配置 ==========
# 默认自动生成，无需修改
# 如需自定义，取消注释并填入您的值
# JWT_SECRET 至少 32 个字符，ANON_KEY 和 SERVICE_ROLE_KEY 需要使用 JWT_SECRET 生成
# 参考：https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys

# 取消注释以使用自定义值（留空则自动生成）
#JWT_SECRET=""
#ANON_KEY=""
#SERVICE_ROLE_KEY=""

# ========== 可选配置 ==========
# Swap 大小（GB），设为 0 禁用自动创建
SWAP_SIZE_GB=4

# PostgreSQL 版本 (15, 16, 17, 18)
PG_VERSION=18

# 时区
TIMEZONE="Asia/Shanghai"

# ========== S3 存储选择 ==========
# 可选值: minio | rustfs | external
# - minio:    Pigsty 默认，资源占用较高 (~500MB)
# - rustfs:   高性能 Rust S3，性能优于 MinIO，资源占用极低 [默认推荐]
# - external: 使用外部 S3 服务（阿里云 OSS、腾讯云 COS 等）
S3_STORAGE_TYPE="rustfs"

# 如果选择 external，需要配置以下参数
#EXTERNAL_S3_ENDPOINT="https://oss-cn-beijing.aliyuncs.com"
#EXTERNAL_S3_REGION="oss-cn-beijing"
#EXTERNAL_S3_BUCKET="your-bucket"
#EXTERNAL_S3_ACCESS_KEY="your-access-key"
#EXTERNAL_S3_SECRET_KEY="your-secret-key"
#
# Garage 下载地址自定义 (可选，用于加速下载)
#GARAGE_DOWNLOAD_URL="https://your-mirror.com/garage"

# ========== Edge Functions 运行时 ==========
# 可选值: deno | bun
# - deno: Supabase 官方运行时（默认）
# - bun:  高性能 Bun.js 运行时（完全兼容 supabase.functions.invoke()）
EDGE_RUNTIME="deno"

# 可选值: on | off | postgres
# - on:       完整功能 (ClickHouse + Logflare), 需 4GB+ 内存
# - off:      禁用 (移除相关容器), 节省资源
# - postgres: 轻量级 (使用主数据库存储日志), 兼顾监控与性能 [默认]
ENABLE_ANALYTICS="postgres"

# Bun 运行时配置（仅当 EDGE_RUNTIME="bun" 时生效）
# Docker Hub 镜像地址（自动从 Docker Hub 拉取，无需本地构建）
#BUN_FUNCTIONS_IMAGE="zuohuadong/supabase-bun-function:latest"
# 使用特定版本: zuohuadong/supabase-bun-function:20241230-abc1234
# Bun 容器服务端口
#BUN_FUNCTIONS_PORT=9001
# Bun 函数目录名称
#BUN_FUNCTIONS_DIR="bun-functions"

# ========== SMTP 配置（可选）==========
# 取消注释以启用邮件功能
#SMTP_HOST="smtp.example.com"
#SMTP_PORT=587
#SMTP_USER="your-smtp-user"
#SMTP_PASS="your-smtp-password"
#SMTP_SENDER_NAME="Supabase"
#SMTP_ADMIN_EMAIL="admin@example.com"
