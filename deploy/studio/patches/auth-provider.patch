+// Custom auth provider that uses relative URLs for SupaCloud
+function GoTrueAuthProvider({ children, ...props }: any) {
+  // For SupaCloud platform, use relative URL (will be proxied through Next.js)
+  const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL || ''
+  const isRelativeUrl = supabaseUrl.startsWith('/') || supabaseUrl === ''
+  
+  if (isRelativeUrl && typeof window !== 'undefined') {
+    // Override the URL to use current origin
+    const clientUrl = window.location.origin
+    return (
+      <GoTrueAuthProviderBase
+        {...props}
+        auth={{
+          ...props.auth,
+          url: clientUrl,
+        }}
+      >
+        {children}
+      </GoTrueAuthProviderBase>
+    )
+  }
+  
+  return <GoTrueAuthProviderBase {...props}>{children}</GoTrueAuthProviderBase>
+}
