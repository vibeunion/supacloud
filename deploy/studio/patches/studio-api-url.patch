diff --git a/apps/studio/lib/constants/index.ts b/apps/studio/lib/constants/index.ts
--- a/apps/studio/lib/constants/index.ts
+++ b/apps/studio/lib/constants/index.ts
@@ -13,8 +13,14 @@ export const IS_TEST_ENV = process.env.NEXT_PUBLIC_NODE_ENV === 'test'
 
 export const API_URL = (() => {
   if (process.env.NODE_ENV === 'test') return 'http://localhost:3000/api'
-  //  If running in platform, use API_URL from the env var
-  if (IS_PLATFORM) return process.env.NEXT_PUBLIC_API_URL!
+  // If running in platform, support relative path (auto-detect origin)
+  if (IS_PLATFORM && process.env.NEXT_PUBLIC_API_URL) {
+    const url = process.env.NEXT_PUBLIC_API_URL
