# SupaCloud Local Dev Environment Defaults

POSTGRES_PASSWORD=postgres
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key
MASTER_TOKEN=supacloud-local-master-token
PGREDIS_RUNTIME_INTERNAL_TOKEN=supacloud-local-pgredis-token-change-me
PGREDIS_RUNTIME_CAPABILITY_TTL_MS=600000
PGREDIS_RUNTIME_INTERNAL_TIMEOUT_MS=5000
SECRETS_ENCRYPTION_KEY=super-secret-jwt-token-with-at-least-32-characters-long
LEGACY_SECRETS_ENCRYPTION_KEY=
SUPAOAUTH_BFF_SIGNING_SECRET=

# Ports
CADDY_HTTP_PORT=8000
CADDY_HTTPS_PORT=8443
POSTGRES_PORT=5432
API_PORT=9090
EDGE_RUNTIME_PORT=9000
PGREDIS_RUNTIME_PORT=9010

# Edge Runtime config
WORKER_POOL_SIZE=2
PGREDIS_RUNTIME_CONNECTIONS_PER_TENANT=2
PGREDIS_RUNTIME_L1_MAX_ENTRIES=1000
PGREDIS_RUNTIME_L1_TTL_MS=30000
