#!/bin/sh
set -eu

key_file="${PGSODIUM_KEY_FILE:-/run/secrets/pgsodium_key}"

if [ -r "$key_file" ]; then
  key="$(tr -d '[:space:]' < "$key_file")"
elif [ -n "${PGSODIUM_KEY:-}" ]; then
  key="$PGSODIUM_KEY"
else
  echo "pgsodium key is not configured; set PGSODIUM_KEY or mount PGSODIUM_KEY_FILE" >&2
  exit 1
fi

case "$key" in
  *[!0-9a-fA-F]* | "" )
    echo "pgsodium key must be a 64-character hex string" >&2
    exit 1
    ;;
esac

if [ "${#key}" -ne 64 ]; then
  echo "pgsodium key must be a 64-character hex string" >&2
  exit 1
fi

printf '%s\n' "$key"
