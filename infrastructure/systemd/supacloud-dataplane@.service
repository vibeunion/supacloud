[Unit]
Description=SupaCloud Data API for tenant %i
Documentation=https://github.com/vibeunion/supacloud
After=network.target patroni.service
Wants=patroni.service
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=simple
User=supacloud-%i
Group=supacloud-%i
Environment="SUPACLOUD_DATAPLANE_RUNTIME_DIR=/etc/supacloud/dataplane"
EnvironmentFile=-/etc/supacloud/dataplane/%i.env
ExecStart=/usr/local/bin/bun /usr/local/libexec/supacloud/dataplane-main.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/supacloud/dataplane
MemoryMax=512M
CPUWeight=40

[Install]
WantedBy=multi-user.target