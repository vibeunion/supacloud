[Unit]
Description=SupaCloud Image Service
Documentation=https://github.com/vibeunion/supacloud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=IMAGE_SERVICE_HOST=127.0.0.1
Environment=IMAGE_SERVICE_PORT=9010
EnvironmentFile=-/etc/supabase/image-service.env
CacheDirectory=supacloud-image
ExecStartPre=/bin/sh -ec 'test -x /usr/local/bin/supacloud-image'
ExecStart=/usr/local/bin/supacloud-image
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
CapabilityBoundingSet=
MemoryHigh=512M
MemoryMax=1G

[Install]
WantedBy=multi-user.target
