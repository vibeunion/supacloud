[Unit]
Description=SupaCloud Storage Data Plane
Documentation=https://github.com/vibeunion/supacloud
After=network-online.target
Wants=network-online.target
# Own systemd cgroup. Do not Require=, BindsTo=, PartOf=, or
# JoinsNamespaceOf= supacloud.service. Stopping the Management API must not
# stop this process. This is not a database standby and not multi-node HA.

[Service]
Type=simple
ExecStart=/usr/local/bin/supacloud --storage-data-plane
Restart=on-failure
RestartSec=2
EnvironmentFile=-/etc/supabase/management-api.env
Environment=STORAGE_DATA_PLANE_HOST=127.0.0.1
Environment=STORAGE_DATA_PLANE_PORT=9108
StandardOutput=journal
StandardError=journal
SyslogIdentifier=supacloud-storage-data-plane
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
