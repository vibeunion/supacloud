{
  "version": "0.0.2",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "check:esm": "node .github/scripts/esm-package-policy.mjs",
    "test:esm": "node --experimental-strip-types --test .github/scripts/esm-package-policy.test.mjs .github/scripts/esm-package-launcher.test.mjs .github/scripts/esm-package-cli-resolution.test.mjs .github/scripts/esm-package-sdk.test.mjs",
    "verify:commands": "bun run scripts/verify-command-migration.ts",
    "verify:starter": "bun --no-env-file scripts/check_app_starter.ts",
    "check:boundaries": "bun run scripts/check_workspace_boundaries.ts",
    "check:invariants": "bun run scripts/check_business_invariants.ts",
    "check:type-safety": "bun run scripts/check_type_safety.ts",
    "test:type-safety": "bun run scripts/check_type_safety.ts --test",
    "typecheck:tools": "bun run --cwd packages/compiler tsc -p ../../tsconfig.tools.json --noEmit",
    "check:public-api": "bun scripts/check_public_api.ts",
    "update:public-api": "bun scripts/check_public_api.ts --update",
    "check:diagnostic-docs": "bun scripts/check_diagnostic_docs.ts",
    "nx": "node scripts/workspace/nx.mjs",
    "check:workspace": "node scripts/workspace/cli.mjs check",
    "workspace:graph": "node scripts/workspace/cli.mjs graph",
    "workspace:affected": "node scripts/workspace/cli.mjs affected",
    "workspace:build": "node scripts/workspace/cli.mjs build",
    "workspace:prepare": "node scripts/workspace/cli.mjs prepare",
    "test:workspace": "node --test scripts/workspace/workspace.test.mjs scripts/workspace/source.test.mjs scripts/workspace/nx.test.mjs scripts/workspace/source-hardening.test.mjs scripts/workspace/source-baseline.test.mjs scripts/workspace/starter-sync.test.mjs scripts/workspace/cache-policy.test.mjs",
    "check:source-boundaries": "bun scripts/workspace/source-check.mjs",
    "check:source-regressions": "bun scripts/workspace/source-check.mjs --baseline",
    "test:nx-acceptance": "node scripts/workspace/nx.acceptance.mjs",
    "workspace:sync": "node scripts/workspace/starter-sync.mjs",
    "check:workspace-sync": "node scripts/workspace/starter-sync.mjs --check",
    "test:nx-cache": "node scripts/workspace/cache.acceptance.mjs"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nx": "23.2.1"
  }
}
