{
  "name": "@supacloud/admin",
  "version": "0.18.1",
  "description": "Platform administration CLI for SupaCloud operators",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "supacloud-admin": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node --external cpu-features",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "supacloud",
    "admin",
    "ssh",
    "ops"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/admin"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/ssh2": "^1.15.5",
    "typescript": "^7.0.2"
  }
}
