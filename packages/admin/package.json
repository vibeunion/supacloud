{
  "name": "@supacloud/admin",
  "version": "0.26.0",
  "description": "Platform administration CLI for SupaCloud operators",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "supacloud-admin": "dist/index.js"
  },
  "files": [
    "NOTICE",
    "LICENSE-APACHE-2.0.txt",
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "prepare:tool-runtime": "bun run --cwd ../cli build:tool-runtime && bun install --force --ignore-scripts --frozen-lockfile",
    "prebuild": "bun run prepare:tool-runtime",
    "build": "bun build src/index.ts --outdir dist --target node --conditions=supacloud-source --external cpu-features",
    "prepublishOnly": "bun run build",
    "pretypecheck": "bun run prepare:tool-runtime",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "supacloud",
    "admin",
    "ssh",
    "ops"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/admin"
  },
  "dependencies": {
    "@supacloud/delivery": "file:../delivery",
    "typebox": "1.3.34",
    "@supacloud/cli": "file:../cli",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/ssh2": "^1.15.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@supacloud/contracts": "file:../contracts",
    "@supacloud/db": "file:../db",
    "@supacloud/delivery": "file:../delivery",
    "@graphql-tools/utils": "^12.0.3"
  }
}
