{
  "name": "@supacloud/app-svelte",
  "version": "0.3.0",
  "description": "Svelte lifecycle binding for SupaCloud command scopes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --outdir dist --target browser --external svelte --external @supacloud/contracts",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit && svelte-check --tsconfig ./tsconfig.test.json",
    "test": "bun test",
    "test:browser": "bun src/browser-server.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@supacloud/contracts": "file:../contracts"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "6.0.3",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/app-svelte"
  }
}
