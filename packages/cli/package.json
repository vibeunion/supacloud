{
  "name": "@supacloud/cli",
  "version": "0.74.1",
  "description": "Project-scoped CLI for SupaCloud users",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "supacloud-cli": "dist/index.js"
  },
  "files": [
    "NOTICE",
    "LICENSE-APACHE-2.0.txt",
    "dist",
    "README.md",
    "skills"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "prepare:db": "bun install --cwd ../contracts --frozen-lockfile && bun run --cwd ../contracts build && bun install --cwd ../db --force --frozen-lockfile && bun run --cwd ../db build && bun install --force --frozen-lockfile",
    "prebuild": "bun run prepare:db",
    "build": "bun build src/index.ts --outdir dist --target node --conditions=supacloud-source",
    "pretypecheck": "bun install --cwd ../delivery --frozen-lockfile && bun install --cwd ../compiler --frozen-lockfile && bun run --cwd ../compiler build && bun run prepare:db",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "supacloud",
    "cli",
    "deploy",
    "supabase"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@supacloud/compiler": "^0.42.0",
    "@supacloud/delivery": "file:../delivery",
    "@supacloud/db": "file:../db",
    "fflate": "^0.8.3",
    "typebox": "1.3.34"
  },
  "overrides": {
    "@supacloud/contracts": "file:../contracts",
    "@supacloud/delivery": "file:../delivery",
    "@graphql-tools/utils": "^12.0.3"
  },
  "devDependencies": {
    "@supacloud/elysia": "^0.24.1",
    "@types/bun": "^1.4.2",
    "effect": "4.0.2",
    "elysia": "2.0.0-beta.21",
    "typescript": "^7.0.2"
  }
}
