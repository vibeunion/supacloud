{
  "name": "@supacloud/commands",
  "version": "0.4.0",
  "description": "Storage-independent durable command execution and recovery",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./typebox": {
      "types": "./dist/typebox.d.ts",
      "import": "./dist/typebox.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts src/typebox.ts --outdir dist --target node --external @supacloud/contracts --external @sinclair/typebox",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@supacloud/contracts": "file:../contracts"
  },
  "devDependencies": {
    "@sinclair/typebox": "0.34.52",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "peerDependenciesMeta": {
    "@sinclair/typebox": { "optional": true }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/commands"
  }
}
