{
  "name": "@supacloud/compiler",
  "version": "0.62.6",
  "description": "Static compiler for @supacloud/app metadata: builds the application graph from AST, validates it, and generates reflection-free factory code",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "supacloud-compiler": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js",
      "default": "./dist/diagnostics.js"
    }
  },
  "files": [
    "NOTICE",
    "LICENSE-APACHE-2.0.txt",
    "dist",
    "README.md",
    "DELIVERY.md"
  ],
  "scripts": {
    "build": "bun run clean && bun run build:js && bun run build:types",
    "prepare:db": "bun install --cwd ../contracts --frozen-lockfile && bun run --cwd ../contracts build && bun install --cwd ../db --force --frozen-lockfile && bun run --cwd ../db build && bun install --force --frozen-lockfile",
    "prebuild": "bun run prepare:db",
    "pretypecheck": "bun run prepare:db",
    "build:js": "bun build src/index.ts src/diagnostics.ts src/cli.ts src/delivery-bundle-worker.ts src/database-governance-worker.ts --outdir dist --target node --conditions=supacloud-source --external typescript --external 'typescript/*' --external @supacloud/db --external @supacloud/db/source-contracts --external graphql --external '@graphql-codegen/*'",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build && bun run test:package",
    "test": "bun test",
    "test:package": "SUPACLOUD_COMPILER_TEST_CLI=\"$PWD/dist/cli.js\" bun test src/graphql-package.test.ts",
    "benchmark": "bun run src/benchmark.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "supacloud",
    "compiler",
    "di",
    "codegen",
    "elysia"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/compiler"
  },
  "dependencies": {
    "@supacloud/db": "0.25.0",
    "@supacloud/delivery": "file:../delivery",
    "typebox": "1.4.3",
    "@graphql-codegen/core": "^6.2.2",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16",
    "typescript": "7.1.0-beta"
  },
  "overrides": {
    "@supacloud/contracts": "file:../contracts",
    "@supacloud/db": "file:../db",
    "@graphql-tools/utils": "^12.0.4",
    "@whatwg-node/promise-helpers": "2.0.0",
    "deepmerge-ts": "8.0.2",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@types/bun": "^1.4.4",
    "@zenstackhq/schema": "3.10.0",
    "@zenstackhq/orm": "3.10.0"
  }
}
