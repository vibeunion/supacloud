{
  "name": "@supacloud/contracts",
  "version": "0.8.0",
  "description": "SupaCloud command protocol with optional client and browser entrypoints",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    }
  },
  "files": [
    "NOTICE",
    "LICENSE-APACHE-2.0.txt",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run clean && bun run build:js && bun run build:types",
    "build:js": "bun run build:js:esm && bun run build:js:cjs",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/copy-dual-declarations.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "build:js:esm": "bun build src/index.ts src/client.ts src/browser.ts --outdir dist --format esm --entry-naming \"[name].mjs\" --chunk-naming \"[name]-[hash].mjs\" --target browser --splitting",
    "build:js:cjs": "bun build src/index.ts src/client.ts src/browser.ts --outdir dist --format cjs --entry-naming \"[name].cjs\" --chunk-naming \"[name]-[hash].cjs\" --target browser",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/contracts"
  },
  "module": "./dist/index.mjs"
}
