{
  "name": "@supacloud/db",
  "version": "0.23.0",
  "description": "Database governance layer for SupaCloud: RLS policies, RPC functions and grants as first-class resources, with manifest/catalog reconciliation",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "supacloud-sql-impact": "./dist/sql-impact-cli.js",
    "supacloud-db": "./dist/source-contracts-cli.js",
    "supacloud-model": "./dist/model-cli.js"
  },
  "exports": {
    "./source-contracts": {
      "types": "./dist/source-contracts.d.ts",
      "import": "./dist/source-contracts.js"
    },
    "./source-contracts-cli": "./dist/source-contracts-cli.js",
    "./sql-analysis": {
      "types": "./dist/sql-analysis.d.ts",
      "import": "./dist/sql-analysis.js"
    },
    "./bun": {
      "types": "./dist/command-bun.d.ts",
      "import": "./dist/command-bun.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./typescript": {
      "supacloud-source": "./src/typescript.ts",
      "types": "./dist/typescript.d.ts",
      "import": "./dist/typescript.js"
    },
    "./zenstack": {
      "types": "./dist/zenstack.d.ts",
      "import": "./dist/zenstack.js"
    },
    "./bun-dialect": {
      "types": "./dist/bun-dialect.d.ts",
      "import": "./dist/bun-dialect.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    }
  },
  "files": [
    "src/typescript.ts",
    "src/typescript-source.ts",
    "NOTICE",
    "LICENSE-APACHE-2.0.txt",
    "dist",
    "README.md",
    "MIGRATION_BINDINGS.md"
  ],
  "scripts": {
    "build": "bun run clean && bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts src/typescript.ts src/command-bun.ts src/model.ts src/model-cli.ts src/zenstack.ts src/bun-dialect.ts src/sql-analysis.ts src/sql-impact-cli.ts src/source-contracts.ts src/source-contracts-cli.ts --root src --outdir dist --target node --external bun --external @supacloud/contracts --external @zenstackhq/orm --external @zenstackhq/schema --external @zenstackhq/plugin-policy --external kysely --external libpg-query --external typescript --external 'typescript/*' --external @zenstackhq/language --external @zenstackhq/sdk",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "supacloud",
    "database",
    "governance",
    "rls",
    "postgresql"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/db"
  },
  "devDependencies": {
    "typebox": "1.4.3",
    "@sinclair/typebox": "0.34.52",
    "@types/bun": "^1.4.4",
    "@zenstackhq/cli": "3.10.0",
    "prisma": "6.19.3",
    "pg": "8.23.1"
  },
  "dependencies": {
    "libpg-query": "18.1.5",
    "@supacloud/contracts": "file:../contracts",
    "typescript": "7.1.0-beta",
    "@zenstackhq/orm": "3.10.0",
    "@zenstackhq/schema": "3.10.0",
    "@zenstackhq/plugin-policy": "3.10.0",
    "kysely": "0.29.0",
    "@zenstackhq/language": "3.10.0",
    "@zenstackhq/sdk": "3.10.0"
  },
  "overrides": {
    "@supacloud/contracts": "file:../contracts",
    "deepmerge-ts": "8.0.2",
    "prisma": "6.19.3"
  }
}
