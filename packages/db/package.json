{
  "name": "@supacloud/db",
  "version": "0.14.0",
  "description": "Database governance layer for SupaCloud: RLS policies, RPC functions and grants as first-class resources, with manifest/catalog reconciliation",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "supacloud-sql-impact": "./dist/sql-impact-cli.js",
    "supacloud-db": "./dist/source-contracts-cli.js"
  },
  "exports": {
    "./source-contracts": {
      "types": "./dist/source-contracts.d.ts",
      "import": "./dist/source-contracts.js"
    },
    "./source-contracts-cli": "./dist/source-contracts-cli.js",
    "./sql-analysis": {
      "types": "./dist/sql-analysis.d.ts",
      "import": "./dist/sql-analysis.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./drizzle-bun": {
      "types": "./dist/drizzle-bun.d.ts",
      "import": "./dist/drizzle-bun.js"
    },
    "./bun": {
      "types": "./dist/command-bun.d.ts",
      "import": "./dist/command-bun.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "NOTICE",
    "LICENSE-APACHE-2.0.txt",
    "dist",
    "README.md",
    "MIGRATION_BINDINGS.md"
  ],
  "scripts": {
    "build": "bun run clean && bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts src/command-bun.ts src/drizzle.ts src/drizzle-bun.ts src/sql-analysis.ts src/sql-impact-cli.ts src/source-contracts.ts src/source-contracts-cli.ts --outdir dist --target node --external bun --external @supacloud/contracts --external drizzle-orm --external libpg-query --external @typescript/typescript6",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:drizzle": "tsc -p tsconfig.drizzle.json --noEmit"
  },
  "keywords": [
    "supacloud",
    "database",
    "governance",
    "rls",
    "postgresql"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/db"
  },
  "devDependencies": {
    "typebox": "1.3.34",
    "@sinclair/typebox": "0.34.52",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@typescript/typescript6": "^6.0.2",
    "libpg-query": "18.1.4",
    "@supacloud/contracts": "file:../contracts"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.5-169397b"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "overrides": {
    "@supacloud/contracts": "file:../contracts"
  }
}
