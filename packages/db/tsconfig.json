{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@supacloud/db-zenstack": ["../db-zenstack/src/index.ts"],
      "@supacloud/db-zenstack/model": ["../db-zenstack/src/model.ts"],
      "@supacloud/db-zenstack/cli": ["../db-zenstack/src/model-cli.ts"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts"
  ]
}
