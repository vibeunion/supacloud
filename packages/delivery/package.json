{
  "name": "@supacloud/delivery",
  "version": "0.3.0",
  "description": "Shared immutable delivery artifact contracts and verification for SupaCloud",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "supacloud-source": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/delivery-schema.ts",
      "supacloud-source": "./src/delivery-schema.ts",
      "bun": "./src/delivery-schema.ts",
      "import": "./dist/delivery-schema.js"
    },
    "./build-schema": {
      "types": "./src/delivery-build-schema.ts",
      "supacloud-source": "./src/delivery-build-schema.ts",
      "bun": "./src/delivery-build-schema.ts",
      "import": "./dist/delivery-build-schema.js"
    },
    "./files": {
      "types": "./src/delivery-files.ts",
      "supacloud-source": "./src/delivery-files.ts",
      "bun": "./src/delivery-files.ts",
      "import": "./dist/delivery-files.js"
    },
    "./artifact": {
      "types": "./src/delivery-artifact.ts",
      "supacloud-source": "./src/delivery-artifact.ts",
      "bun": "./src/delivery-artifact.ts",
      "import": "./dist/delivery-artifact.js"
    },
    "./development": {
      "types": "./src/application-development.ts",
      "supacloud-source": "./src/application-development.ts",
      "bun": "./src/application-development.ts",
      "import": "./dist/application-development.js"
    }
  },
  "files": [
    "NOTICE",
    "LICENSE-APACHE-2.0.txt",
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/delivery-schema.ts src/delivery-build-schema.ts src/delivery-files.ts src/delivery-artifact.ts src/application-activation.ts src/application-development.ts --outdir dist --target node --splitting",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/delivery"
  }
}
