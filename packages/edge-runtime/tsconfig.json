{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": ["*.ts", "scripts/**/*.ts", "shims/**/*.ts", "generated/**/*.ts"],
  "exclude": ["node_modules", "dist", "*.test.ts", "**/*.test.ts", "server-function-config-race.preload.ts", "worker-retirement-stress-fixture.ts"]
}
