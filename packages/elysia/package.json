{
  "name": "@supacloud/elysia",
  "version": "0.18.0",
  "description": "Elysia runtime adapter for SupaCloud compiled modules: application/request scopes, route registration and validation",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "compatibility.json"
  ],
  "scripts": {
    "generate:example": "bun src/generate-webhook-example.ts",
    "build": "bun run clean && bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --outdir dist --target node --external elysia --external jose --external @supacloud/app --external @supacloud/db --external @supacloud/contracts",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:conformance": "bun test src/conformance.test.ts",
    "test:runtime-safety": "SUPACLOUD_REQUIRE_RUNTIME_SAFETY=1 bun test src/runtime-safety.test.ts",
    "test:contract-upgrade": "bun test src/contract-upgrade.test.ts",
    "bench:http-policy": "bun bench/http-policy.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "supacloud",
    "elysia",
    "adapter",
    "dependency-injection",
    "module"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/elysia"
  },
  "dependencies": {
    "@supacloud/app": "file:../app",
    "@supacloud/contracts": "file:../contracts",
    "jose": "^6.2.11"
  },
  "overrides": {
    "@supacloud/contracts": "file:../contracts",
    "@supacloud/commands": "file:../commands"
  },
  "peerDependencies": {
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@supacloud/compiler": "file:../compiler",
    "@supacloud/commands": "file:../commands",
    "@supacloud/db": "file:../db",
    "@types/bun": "^1.4.2",
    "elysia": "^1.4.30",
    "typescript": "^7.0.2"
  }
}
