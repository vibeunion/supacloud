{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "types": [
      "bun"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "@supabase/supabase-js": [
        "../supacloud-js/node_modules/@supabase/supabase-js"
      ]
    }
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
