{
  "name": "@supacloud/management-api",
  "version": "1.0.0",
  "description": "SupaCloud Multi-tenant Management API",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:init": "bun run src/db/init.ts",
    "tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:amd64": "bun build src/index.ts --compile --minify --target=bun-linux-x64 --outfile=supacloud-api-linux-amd64",
    "build:arm64": "bun build src/index.ts --compile --minify --target=bun-linux-arm64 --outfile=supacloud-api-linux-arm64",
    "build:all": "bun run build:amd64 && bun run build:arm64"
  },
  "dependencies": {
    "elysia": "^1.4.25",
    "@elysiajs/swagger": "^1.3.1",
    "@elysiajs/cors": "^1.4.1",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "typescript": "^5.9.3"
  }
}