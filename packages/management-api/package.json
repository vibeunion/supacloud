{
  "name": "@supacloud/management-api",
  "version": "0.11.5",
  "description": "SupaCloud Multi-tenant Management API",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:init": "bun run src/db/init.ts",
    "realtime:reconcile": "bun run scripts/reconcile-realtime-tenants.ts",
    "realtime:reconcile-schema": "bun run scripts/reconcile-realtime-schema-privileges.ts",
    "tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:sdk": "bun test tests/integration/sdk.automation.test.ts",
    "prebuild": "bun run scripts/patch-dependencies.ts && cd ../web-console && bun install && bun run build",
    "build:amd64": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile=supacloud-linux-amd64",
    "build:arm64": "bun build src/index.ts --compile --target=bun-linux-arm64 --outfile=supacloud-linux-arm64",
    "build:linux": "bun run build:amd64 && bun run build:arm64",
    "build:macos-amd64": "bun build src/index.ts --compile --target=bun-macos-x64 --outfile=supacloud-macos-amd64",
    "build:macos-arm64": "bun build src/index.ts --compile --target=bun-macos-arm64 --outfile=supacloud-macos-arm64",
    "build:macos": "bun run build:macos-amd64 && bun run build:macos-arm64",
    "build:all": "bun run prebuild && bun run build:linux && bun run build:macos"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@sinclair/typebox": "^0.34.49",
    "@svadmin/core": "^0.23.4",
    "@svadmin/elysia": "^0.10.5",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "aws4fetch": "^1.0.20",
    "elysia": "^1.4.25",
    "jose": "^6.1.0",
    "nanoid": "^5.1.6",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@types/bun": "^1.3.9",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "hono": "^4.12.12",
    "@hono/node-server": "^1.19.13",
    "path-to-regexp": "^8.4.0"
  }
}
