{
  "name": "@supacloud/query",
  "version": "0.1.0",
  "description": "TanStack Query adapter for SupaCloud procedure client with explicit invalidation tags",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "NOTICE",
    "LICENSE-APACHE-2.0.txt",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --outdir dist --target browser --external @tanstack/query-core",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.104.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/query-core": "5.104.1",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "license": "Apache-2.0",
  "engines": { "node": ">=22.12.0" },
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/query"
  }
}
