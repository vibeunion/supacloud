{
  "name": "@supacloud/js",
  "version": "0.11.0",
  "description": "Platform SDK for SupaCloud, built on top of supabase-js",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "supacloud",
    "supabase",
    "sdk",
    "background-tasks",
    "realtime"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zuohuadong/supacloud.git",
    "directory": "packages/supacloud-js"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.103.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@supabase/supabase-js": "^2.103.0",
    "typescript": "^6.0.0"
  }
}
