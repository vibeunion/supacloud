{
  "name": "@supacloud/js",
  "version": "0.33.0",
  "description": "Platform SDK for SupaCloud, built on top of supabase-js",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./task-events": {
      "types": "./dist/task-events.d.ts",
      "import": "./dist/task-events.js",
      "default": "./dist/task-events.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun run clean && bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts src/task-events.ts --outdir dist --target node --external @supabase/supabase-js --external @supacloud/contracts",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build",
    "typecheck:consumer": "tsc -p tsconfig.consumer.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "supacloud",
    "supabase",
    "sdk",
    "background-tasks",
    "realtime"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/supacloud-js"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.115.0"
  },
  "dependencies": {
    "@supacloud/contracts": "file:../contracts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@supabase/supabase-js": "^2.115.0",
    "typescript": "^7.0.2"
  }
}
