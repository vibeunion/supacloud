# Replace app.example.com with the real public hostname.
# Lite must remain bound to 127.0.0.1:54321 behind this proxy.
https://app.example.com {
	encode zstd gzip

	# Caddy terminates TLS and forwards WebSocket/Realtime upgrades by default.
	reverse_proxy 127.0.0.1:54321

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
