{
  "name": "supacloud",
  "version": "0.18.25",
  "description": "Unified entrypoint: `supacloudctl cli` and `supacloudctl admin` in one command",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "supacloudctl": "dist/index.js"
  },
  "files": [
    "NOTICE",
    "LICENSE-APACHE-2.0.txt",
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "supacloud",
    "cli",
    "admin",
    "supabase",
    "umbrella"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/supacloud.git",
    "directory": "packages/supacloud"
  },
  "dependencies": {
    "@supacloud/cli": "^0.115.4",
    "@supacloud/admin": "^0.30.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.21.0",
    "@supacloud/compiler": "file:../compiler",
    "@supacloud/delivery": "file:../delivery",
    "@supacloud/cli": "file:../cli",
    "@supacloud/admin": "file:../admin",
    "@supacloud/db": "file:../db"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
