 .../src/services/shell.service.ts             | 41 +++++++++-
 .../src/services/tenant-runtime.service.ts    | 74 ++++++++++++++++---
 scripts/lib/backup_manager.sh                 |  2 +-
 4 files changed, 107 insertions(+), 18 deletions(-)

