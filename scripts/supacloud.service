[Unit]
Description=SupaCloud Management API
Documentation=https://github.com/supacloud/supacloud
After=network.target postgresql.service nginx.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/supacloud/management-api
ExecStart=/usr/local/bin/bun run src/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=supacloud

# 环境变量
EnvironmentFile=-/etc/supabase/management-api.env

# 安全限制
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/etc/nginx/sites-enabled/supa-tenants /etc/supabase

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
