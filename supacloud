#!/bin/bash
# SupaCloud CLI - 项目管理工具
# 用法: supacloud <command> [args]

set -euo pipefail

# 加载配置
if [[ -f /etc/supabase/master-token.env ]]; then
    source /etc/supabase/master-token.env
fi

API_URL="${MANAGEMENT_API_URL:-http://localhost:9090}"
TOKEN="${MASTER_TOKEN:-}"

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
    cat <<EOF
SupaCloud CLI - 多租户项目管理工具

用法: supacloud <command> [args]

命令:
  list                     列出所有项目
  create <name>            创建新项目
  info <ref>               查看项目详情
  delete <ref>             删除项目
  status <ref>             查看项目状态
  restart <ref>            重启项目服务
  keys <ref>               获取项目 API 密钥
  health                   健康检查

示例:
  supacloud list
  supacloud create "My Project"
  supacloud info abc123
  supacloud keys abc123

环境变量:
  MANAGEMENT_API_URL       API 地址 (默认: http://localhost:9090)
  MASTER_TOKEN             认证令牌
EOF
    exit 1
}

api_call() {
    local method="$1"
    local endpoint="$2"
    local data="${3:-}"

    local curl_args=(
        -s
        -X "$method"
        -H "Authorization: Bearer ${TOKEN}"
        -H "Content-Type: application/json"
    )

    if [[ -n "$data" ]]; then
        curl_args+=(-d "$data")
    fi

    curl "${curl_args[@]}" "${API_URL}${endpoint}"
}

cmd_list() {
    echo -e "${BLUE}项目列表${NC}"
    echo "=========="
    api_call GET "/v1/projects" | jq -r '.[] | "\(.ref)\t\(.name)\t\(.status)"' 2>/dev/null || echo "无法获取项目列表"
}

cmd_create() {
    local name="$1"
    echo -e "${BLUE}创建项目: ${name}${NC}"
    local result
    result=$(api_call POST "/v1/projects" "{\"name\": \"${name}\"}")
    echo "$result" | jq . 2>/dev/null || echo "$result"
}

cmd_info() {
    local ref="$1"
    echo -e "${BLUE}项目详情: ${ref}${NC}"
    api_call GET "/v1/projects/${ref}" | jq . 2>/dev/null || echo "项目不存在"
}

cmd_delete() {
    local ref="$1"
    echo -e "${YELLOW}删除项目: ${ref}${NC}"
    read -p "确认删除? (y/N) " confirm
    if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
        api_call DELETE "/v1/projects/${ref}" | jq . 2>/dev/null
    else
        echo "已取消"
    fi
}

cmd_status() {
    local ref="$1"
    echo -e "${BLUE}项目状态: ${ref}${NC}"
    api_call GET "/v1/projects/${ref}/status" | jq . 2>/dev/null || echo "项目不存在"
}

cmd_restart() {
    local ref="$1"
    echo -e "${YELLOW}重启项目: ${ref}${NC}"
    api_call POST "/v1/projects/${ref}/restart" | jq . 2>/dev/null
}

cmd_keys() {
    local ref="$1"
    echo -e "${BLUE}项目 API 密钥: ${ref}${NC}"
    echo "========================"
    api_call GET "/v1/projects/${ref}/api-keys" | jq . 2>/dev/null || echo "项目不存在"
}

cmd_health() {
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -f "${SCRIPT_DIR}/scripts/health_check.sh" ]]; then
        bash "${SCRIPT_DIR}/scripts/health_check.sh"
    elif [[ -f "/opt/supacloud/scripts/health_check.sh" ]]; then
        bash "/opt/supacloud/scripts/health_check.sh"
    else
        # 内联健康检查
        echo "SupaCloud 健康检查"
        curl -sf "${API_URL}/health" && echo -e "${GREEN}✓${NC} Management API" || echo -e "${RED}✗${NC} Management API"
    fi
}

# 检查 Token
check_token() {
    if [[ -z "$TOKEN" ]]; then
        echo -e "${RED}错误: 未设置 MASTER_TOKEN${NC}"
        echo "请设置环境变量或确保 /etc/supabase/master-token.env 存在"
        exit 1
    fi
}

# 主逻辑
[[ $# -lt 1 ]] && usage

command="$1"
shift

case "$command" in
    list)
        check_token
        cmd_list
        ;;
    create)
        check_token
        [[ $# -lt 1 ]] && { echo "用法: supacloud create <name>"; exit 1; }
        cmd_create "$1"
        ;;
    info)
        check_token
        [[ $# -lt 1 ]] && { echo "用法: supacloud info <ref>"; exit 1; }
        cmd_info "$1"
        ;;
    delete)
        check_token
        [[ $# -lt 1 ]] && { echo "用法: supacloud delete <ref>"; exit 1; }
        cmd_delete "$1"
        ;;
    status)
        check_token
        [[ $# -lt 1 ]] && { echo "用法: supacloud status <ref>"; exit 1; }
        cmd_status "$1"
        ;;
    restart)
        check_token
        [[ $# -lt 1 ]] && { echo "用法: supacloud restart <ref>"; exit 1; }
        cmd_restart "$1"
        ;;
    keys)
        check_token
        [[ $# -lt 1 ]] && { echo "用法: supacloud keys <ref>"; exit 1; }
        cmd_keys "$1"
        ;;
    health)
        cmd_health
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo -e "${RED}未知命令: ${command}${NC}"
        usage
        ;;
esac
