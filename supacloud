#!/bin/bash
set -euo pipefail

if [[ -f /etc/supabase/master-token.env ]]; then
    source /etc/supabase/master-token.env
fi

API_URL="${MANAGEMENT_API_URL:-http://localhost:9090}"
TOKEN="${MASTER_TOKEN:-}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
    cat <<EOF
SupaCloud CLI

用法: supacloud <command> [args]

平台命令:
  start                    启动 SupaCloud 核心服务
  stop                     停止 SupaCloud 核心服务
  status                   查看平台服务状态
  logs [service]           查看平台日志
  health                   健康检查

项目命令:
  list                     列出所有项目
  create <name>            创建新项目
  info <ref>               查看项目详情
  delete <ref>             删除项目
  status <ref>             查看项目状态
  restart <ref>            重启项目服务
  keys <ref>               获取项目 API 密钥

环境变量:
  MANAGEMENT_API_URL       API 地址 (默认: http://localhost:9090)
  MASTER_TOKEN             认证令牌
EOF
    exit 1
}

service_exists() {
    systemctl list-unit-files "$1" >/dev/null 2>&1
}

edge_runtime_mode() {
    if [[ -f /etc/supabase/management-api.env ]]; then
        local mode
        mode=$(grep -E '^EDGE_RUNTIME_MODE=' /etc/supabase/management-api.env 2>/dev/null | tail -n 1 | cut -d'=' -f2- || true)
        mode="${mode//\"/}"
        if [[ -n "$mode" ]]; then
            echo "$mode"
            return
        fi
    fi
    echo "embedded"
}

normalize_service_name() {
    case "${1:-supacloud}" in
        ""|supacloud|management-api)
            echo "supacloud.service"
            ;;
        edge|edge-runtime|supacloud-edge-runtime)
            echo "supacloud-edge-runtime.service"
            ;;
        realtime|supacloud-realtime)
            echo "supacloud-realtime.service"
            ;;
        *)
            if [[ "$1" == *.service ]]; then
                echo "$1"
            else
                echo "$1.service"
            fi
            ;;
    esac
}

show_platform_status() {
    echo -e "${BLUE}平台状态${NC}"
    echo "=========="

    local services=("supacloud.service")
    if [[ "$(edge_runtime_mode)" == "external" ]]; then
        services+=("supacloud-edge-runtime.service")
    fi
    if service_exists "supacloud-realtime.service"; then
        services+=("supacloud-realtime.service")
    fi

    for service in "${services[@]}"; do
        if systemctl is-active --quiet "$service" 2>/dev/null; then
            echo -e "${GREEN}✓${NC} ${service} running"
        else
            echo -e "${RED}✗${NC} ${service} stopped"
        fi
    done

    echo ""
    echo "健康端点: ${API_URL}/health"
    curl -sf "${API_URL}/health" >/dev/null 2>&1 \
        && echo -e "${GREEN}✓${NC} Management API reachable" \
        || echo -e "${RED}✗${NC} Management API unreachable"
}

cmd_start() {
    echo -e "${BLUE}启动平台服务${NC}"
    systemctl start supacloud.service
    if [[ "$(edge_runtime_mode)" == "external" ]] && service_exists "supacloud-edge-runtime.service"; then
        systemctl start supacloud-edge-runtime.service || true
    fi
    echo -e "${GREEN}已启动${NC}"
}

cmd_stop() {
    echo -e "${YELLOW}停止平台服务${NC}"
    if service_exists "supacloud-edge-runtime.service"; then
        systemctl stop supacloud-edge-runtime.service || true
    fi
    if service_exists "supacloud-realtime.service"; then
        systemctl stop supacloud-realtime.service || true
    fi
    systemctl stop supacloud.service
    echo -e "${GREEN}已停止${NC}"
}

cmd_logs() {
    local service
    service=$(normalize_service_name "${1:-supacloud}")
    echo -e "${BLUE}查看日志: ${service}${NC}"
    exec journalctl -u "$service" -n 200 --no-pager
}

api_call() {
    local method="$1"
    local endpoint="$2"
    local data="${3:-}"

    local curl_args=(
        -s
        -X "$method"
        -H "Authorization: Bearer ${TOKEN}"
        -H "Content-Type: application/json"
    )

    if [[ -n "$data" ]]; then
        curl_args+=(-d "$data")
    fi

    curl "${curl_args[@]}" "${API_URL}${endpoint}"
}

cmd_list() {
    echo -e "${BLUE}项目列表${NC}"
    echo "=========="
    api_call GET "/v1/projects" | jq -r '.[] | "\(.ref)\t\(.name)\t\(.status)"' 2>/dev/null || echo "无法获取项目列表"
}

cmd_create() {
    local name="$1"
    echo -e "${BLUE}创建项目: ${name}${NC}"
    local result
    result=$(api_call POST "/v1/projects" "{\"name\": \"${name}\"}")
    echo "$result" | jq . 2>/dev/null || echo "$result"
}

cmd_info() {
    local ref="$1"
    echo -e "${BLUE}项目详情: ${ref}${NC}"
    api_call GET "/v1/projects/${ref}" | jq . 2>/dev/null || echo "项目不存在"
}

cmd_delete() {
    local ref="$1"
    echo -e "${YELLOW}删除项目: ${ref}${NC}"
    read -r -p "确认删除? (y/N) " confirm
    if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
        api_call DELETE "/v1/projects/${ref}" | jq . 2>/dev/null
    else
        echo "已取消"
    fi
}

cmd_project_status() {
    local ref="$1"
    echo -e "${BLUE}项目状态: ${ref}${NC}"
    api_call GET "/v1/projects/${ref}/status" | jq . 2>/dev/null || echo "项目不存在"
}

cmd_restart() {
    local ref="$1"
    echo -e "${YELLOW}重启项目: ${ref}${NC}"
    api_call POST "/v1/projects/${ref}/restart" | jq . 2>/dev/null
}

cmd_keys() {
    local ref="$1"
    echo -e "${BLUE}项目 API 密钥: ${ref}${NC}"
    echo "========================"
    api_call GET "/v1/projects/${ref}/api-keys" | jq . 2>/dev/null || echo "项目不存在"
}

cmd_health() {
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -f "${SCRIPT_DIR}/scripts/health_check.sh" ]]; then
        bash "${SCRIPT_DIR}/scripts/health_check.sh"
    elif [[ -f "/opt/supacloud/scripts/health_check.sh" ]]; then
        bash "/opt/supacloud/scripts/health_check.sh"
    else
        echo "SupaCloud 健康检查"
        curl -sf "${API_URL}/health" && echo -e "${GREEN}✓${NC} Management API" || echo -e "${RED}✗${NC} Management API"
    fi
}

check_token() {
    if [[ -z "$TOKEN" ]]; then
        echo -e "${RED}错误: 未设置 MASTER_TOKEN${NC}"
        echo "请设置环境变量或确保 /etc/supabase/master-token.env 存在"
        exit 1
    fi
}

[[ $# -lt 1 ]] && usage

command="$1"
shift

case "$command" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    status)
        if [[ $# -ge 1 ]]; then
            check_token
            cmd_project_status "$1"
        else
            show_platform_status
        fi
        ;;
    logs)
        cmd_logs "${1:-supacloud}"
        ;;
    list)
        check_token
        cmd_list
        ;;
    create)
        check_token
        [[ $# -lt 1 ]] && { echo "用法: supacloud create <name>"; exit 1; }
        cmd_create "$1"
        ;;
    info)
        check_token
        [[ $# -lt 1 ]] && { echo "用法: supacloud info <ref>"; exit 1; }
        cmd_info "$1"
        ;;
    delete)
        check_token
        [[ $# -lt 1 ]] && { echo "用法: supacloud delete <ref>"; exit 1; }
        cmd_delete "$1"
        ;;
    restart)
        check_token
        [[ $# -lt 1 ]] && { echo "用法: supacloud restart <ref>"; exit 1; }
        cmd_restart "$1"
        ;;
    keys)
        check_token
        [[ $# -lt 1 ]] && { echo "用法: supacloud keys <ref>"; exit 1; }
        cmd_keys "$1"
        ;;
    health)
        cmd_health
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo -e "${RED}未知命令: ${command}${NC}"
        usage
        ;;
esac
