{
  "extends": "./tsconfig.strict.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@typescript/typescript6": ["packages/compiler/node_modules/@typescript/typescript6"],
      "@supacloud/contracts": ["packages/contracts/src/index.ts"],
      "@supacloud/contracts/client": ["packages/contracts/src/client.ts"],
      "@supacloud/contracts/browser": ["packages/contracts/src/browser.ts"],
      "@supacloud/delivery": ["packages/delivery/src/index.ts"],
      "@supacloud/delivery/worker-execution": ["packages/delivery/src/worker-execution.ts"],
      "@supacloud/delivery/schema": ["packages/delivery/src/delivery-schema.ts"],
      "@supacloud/delivery/build-schema": ["packages/delivery/src/delivery-build-schema.ts"],
      "@supacloud/delivery/files": ["packages/delivery/src/delivery-files.ts"],
      "@supacloud/delivery/artifact": ["packages/delivery/src/delivery-artifact.ts"],
      "@supacloud/delivery/development": ["packages/delivery/src/application-development.ts"],
      "@supacloud/delivery/deployment-evidence": ["packages/delivery/src/deployment-evidence.ts"],
      "@supacloud/db": ["packages/db/src/index.ts"],
      "@supacloud/db/bun": ["packages/db/src/command-bun.ts"],
      "@supacloud/db/source-contracts": ["packages/db/src/source-contracts.ts"],
      "@supacloud/db/sql-analysis": ["packages/db/src/sql-analysis.ts"],
      "@supacloud/db/drizzle": ["packages/db/src/drizzle.ts"],
      "@supacloud/db/drizzle-bun": ["packages/db/src/drizzle-bun.ts"]
    },
    "typeRoots": ["./packages/compiler/node_modules/@types"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["scripts/**/*.ts", "packages/management-api/src/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "scripts/fixtures"]
}
